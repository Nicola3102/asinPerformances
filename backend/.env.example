# 复制为 backend/.env 后填写：uvicorn 与 docker-compose 中 backend 服务均读取（config.py 固定加载 backend/.env）。
# Docker 中的 mysql 容器单独使用 backend/docker-mysql.env（见 docker-mysql.env.example），勿把 online_db 等注入 DB 容器。
#
# ========== 本地 MySQL（应用连接；与 docker-mysql.env 中库名/用户/口令一致） ==========
# Docker Compose：后端容器内 MYSQL_HOST 必须为服务名 mysql（与 compose 中服务名一致）
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# 应用业务库（表 asin_performances）；可与 MYSQL_DATABASE 相同或单独库名
MYSQL_DB_NAME=asin_performances

# ========== 在线库（执行 SQL 的数据源） ==========
online_db_host=
online_db_port=3306
online_db_name=
online_db_user=
online_db_pwd=

# 定时同步（东八区每 N 小时执行一次；后端进程需常驻）
enable_scheduled_sync=
sync_interval_hours=
monitor_sync_interval_hours=
group_a_sync_interval_hours=
listing_tracking_write_chunk_size=
listing_tracking_reader_workers=
image_model=
sync_timezone=

# daily_ad_cost_sales 定时（SYNC_TIMEZONE，默认 Asia/上海）：从首跑时刻起 24h 内均匀执行 daily_times 次
enable_daily_ad_cost_sales_schedule=
daily_ad_cost_sales_daily_times=
daily_ad_cost_sales_first_run_hour=
daily_ad_cost_sales_first_run_minute=

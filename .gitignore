# Env and secrets
.env
.env.local
*.env
!.env.example
!backend/.env.example
!backend/docker-mysql.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/

# Logs and run records
*.log
backend/app/log/
backend/app/.last_sync_run

# Trend HTML disk cache (GET /api/trend/session-impression)
backend/charts/.cache/

# Backend docs (local / generated notes; do not track)
backend/docs/

# Backend tests (do not track)
backend/tests/

# Node / frontend (keep in sync with frontend/.gitignore)
node_modules/
frontend/dist/
frontend/dist-ssr/

# IDE / OS
.idea/
.vscode/
.DS_Store
*.sw?

# Docker / local
.docker/
